[Unit]
Description=Cold Chain Traceability Backend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/coldchain/backend
EnvironmentFile=/opt/coldchain/backend/.env
ExecStart=/opt/coldchain/backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
