# 公网 8080 机专用（硬件上报 + 演示看板仍开；勿对本机自拉 live-snapshot）
HOST=127.0.0.1
PORT=8000
WORKERS=1

DATABASE_PATH=/opt/coldchain-backend/backend/device_data.db
FILE_STORAGE_DIR=/opt/coldchain-backend/backend/uploads

CORS_ORIGIN_REGEX=.*

# 本机即硬件源：禁止 HTTP 自拉；预检/监控直接读本地 SQLite
ENABLE_LIVE_HARDWARE_PROXY=false
ALLOW_DEVICE_AUTO_REGISTER=true

# 8080 对外仍需旧接口与看板（开发板 POST /api/device/data）
SEED_DEMO_TASK=true
ENABLE_LEGACY_DEMO_API=true
ENABLE_DEMO_DASHBOARD=true
ENABLE_API_DOCS=false
ALLOW_ADMIN_SELF_REGISTER=false
ALLOW_LOCAL_SIMULATION=false
