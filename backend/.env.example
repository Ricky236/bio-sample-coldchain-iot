# 生产/服务器部署示例（复制为 .env 后按需修改；勿把真实密钥提交进仓库）

HOST=0.0.0.0
PORT=8000
WORKERS=1

# 数据与文件（建议独立数据盘绝对路径）
DATABASE_PATH=data/device_data.db
FILE_STORAGE_DIR=data/uploads

# 跨域（小程序合法域名 / 管理端域名）
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
# CORS_ORIGIN_REGEX=^https://(your-domain\.com|servicewechat\.com)

# 公网硬件源（优先 HTTPS）
HARDWARE_PUBLIC_BASE=http://47.103.152.175:8080
# LIVE_SNAPSHOT_URL=
# LIVE_DEVICE_LATEST_URL=
# LIVE_DEVICE_HISTORY_URL=
# LIVE_DEVICE_EVENTS_URL=

# 生产必须保持关闭
SEED_DEMO_TASK=false
ENABLE_LEGACY_DEMO_API=false
ENABLE_DEMO_DASHBOARD=false
ENABLE_API_DOCS=false
ALLOW_ADMIN_SELF_REGISTER=false
ALLOW_LOCAL_SIMULATION=false
ENABLE_LIVE_HARDWARE_PROXY=true

# 仅当公网快照可见设备号时允许自动登记
ALLOW_DEVICE_AUTO_REGISTER=true

# 光敏开箱阈值（按现场校准）
# LIGHT_BOX_OPEN_THRESHOLD=5000
# LIGHT_BOX_CLOSE_THRESHOLD=6000
# LIGHT_BOX_STATUS_OVERRIDE=true
